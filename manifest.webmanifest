{
  "name": "Mazda3 Care",
  "short_name": "Mazda3",
  "description": "Offline maintenance tracker and guide for a 2025 Mazda3.",
  "id": "./",
  "start_url": "./#/home",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0A0F14",
  "theme_color": "#0F5C8C",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "Log service", "url": "./#/log", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Warning lights", "url": "./#/guide/lights", "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
